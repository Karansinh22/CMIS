# ── HuggingFace (required for pyannote.audio diarization) ────────────────────
# Create a free account at https://huggingface.co, accept the pyannote model
# license at https://huggingface.co/pyannote/speaker-diarization-3.1, then
# generate a token at https://huggingface.co/settings/tokens
HF_TOKEN=

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (default for local dev – no extra setup needed)
DATABASE_URL=sqlite:///./cmis.db
# PostgreSQL example (uncomment when switching):
# DATABASE_URL=postgresql://user:password@localhost:5432/cmis

# ── Whisper model ─────────────────────────────────────────────────────────────
# Options: tiny, base, small, medium, large-v2, large-v3
# "small" is the recommended default (good accuracy on a laptop CPU)
WHISPER_MODEL=small

# ── ASR engine ────────────────────────────────────────────────────────────────
# "whisper" = faster-whisper (local, no internet needed)
# "sarvam"  = Sarvam AI API (optional accuracy upgrade – needs SARVAM_API_KEY)
ASR_ENGINE=whisper
# SARVAM_API_KEY=your_sarvam_key_here

# ── Whisper performance ───────────────────────────────────────────────────────
# auto = use CUDA when available, else CPU
WHISPER_DEVICE=auto
# auto = int8 on CPU, float16 on CUDA
WHISPER_COMPUTE_TYPE=auto
# 1 = greedy decoding (fastest). 5 = most accurate but ~2-3x slower.
WHISPER_BEAM_SIZE=1
# 0 = use all CPU cores
WHISPER_CPU_THREADS=0
# Load models at startup so the first upload doesn't wait for model loading
PRELOAD_MODELS=true

# ── Live transcript streaming ─────────────────────────────────────────────────
# Persist + push transcript lines every N segments or every N seconds
TRANSCRIPT_FLUSH_SEGMENTS=3
TRANSCRIPT_FLUSH_SECONDS=1.5

# ── Live microphone recording ─────────────────────────────────────────────────
# Chunks are cut at a pause once they hold at least MIN seconds, or forcibly at MAX
LIVE_MIN_CHUNK_SECONDS=3.0
LIVE_MAX_CHUNK_SECONDS=10.0
# RMS (0-1 float scale) below which audio counts as silence, and how long a pause must be
LIVE_SILENCE_RMS=0.010
LIVE_SILENCE_SECONDS=0.6

# ── NLP extraction engine ─────────────────────────────────────────────────────
# local = context/intent-aware rule engine (offline, default)
# llm   = language model extraction with automatic fallback to local
NLP_ENGINE=local
# anthropic | ollama  (only used when NLP_ENGINE=llm)
LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# Anthropic model id, or an Ollama model name such as llama3.1
LLM_MODEL=claude-opus-5
OLLAMA_BASE_URL=http://localhost:11434
# Items below this confidence (0-1) are dropped
EXTRACTION_MIN_CONFIDENCE=0.45

# ── Diarization ───────────────────────────────────────────────────────────────
# Set to "true" to enable pyannote diarization; "false" for VAD-only fallback
DIARIZATION_ENABLED=true

# ── LSH index persistence ─────────────────────────────────────────────────────
# Where to store the MinHash LSH index on disk (so it survives restarts)
LSH_INDEX_PATH=./lsh_index.pkl

# ── General ───────────────────────────────────────────────────────────────────
# Directory where uploaded audio files are stored
UPLOAD_DIR=./uploads

# FastAPI debug mode
DEBUG=false
# Allowed browser origins (comma-separated). Use "*" only for local development.
CORS_ORIGINS=*
