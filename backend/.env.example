# ── HuggingFace (required for pyannote.audio diarization) ────────────────────
# Create a free account at https://huggingface.co, accept the pyannote model
# license at https://huggingface.co/pyannote/speaker-diarization-3.1, then
# generate a token at https://huggingface.co/settings/tokens
HF_TOKEN=

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (default for local dev – no extra setup needed)
DATABASE_URL=sqlite:///./cmis.db
# PostgreSQL example (uncomment when switching):
# DATABASE_URL=postgresql://user:password@localhost:5432/cmis

# ── Whisper model ─────────────────────────────────────────────────────────────
# Options: tiny, base, small, medium, large-v2, large-v3
# "small" is the recommended default (good accuracy on a laptop CPU)
WHISPER_MODEL=small

# ── ASR engine ────────────────────────────────────────────────────────────────
# "whisper" = faster-whisper (local, no internet needed)
# "sarvam"  = Sarvam AI API (optional accuracy upgrade – needs SARVAM_API_KEY)
ASR_ENGINE=whisper
# SARVAM_API_KEY=your_sarvam_key_here

# ── Diarization ───────────────────────────────────────────────────────────────
# Set to "true" to enable pyannote diarization; "false" for VAD-only fallback
DIARIZATION_ENABLED=true

# ── LSH index persistence ─────────────────────────────────────────────────────
# Where to store the MinHash LSH index on disk (so it survives restarts)
LSH_INDEX_PATH=./lsh_index.pkl

# ── General ───────────────────────────────────────────────────────────────────
# Directory where uploaded audio files are stored
UPLOAD_DIR=./uploads

# FastAPI debug mode
DEBUG=false
